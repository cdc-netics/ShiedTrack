{
  "name": "shieldtrack",
  "version": "2.2.0",
  "description": "ShieldTrack - Cybersecurity Findings Management",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.js",
    "start": "docker compose up --build",
    "start:detached": "docker compose up --build -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f --tail 200",
    "install:all": "pnpm --dir backend install && pnpm --dir frontend install"
  },
  "dependencies": {
    "pdfmake": "^0.3.2"
  }
}
