# =============================================================================
# ShieldTrack - plantilla de entorno para Docker Compose
# =============================================================================
# 1) Copiar a .env en la raiz del repo (junto a docker-compose.yml):
#      Linux/macOS/Git Bash:  cp .env.example .env
#      Windows PowerShell:    Copy-Item .env.example .env
# 2) Cambiar JWT_SECRET, MONGO_INITDB_ROOT_PASSWORD y OWNER_SEED_PASSWORD.
# 3) docker compose up --build -d
# Guia completa: docs/SETUP.md (instalacion) y docs/DEPLOYMENT.md (servidores).
# El archivo .env NUNCA se sube a Git.

# --- Puertos publicados en el host (cambiar si estan ocupados) ---
MONGO_PORT=27017
BACKEND_PORT=3000
FRONTEND_PORT=80

# Host o IP con que los usuarios abren el sitio (ej. 10.0.101.70 o shieldtrack.midominio.cl).
# Se usa para construir FRONTEND_URL y CORS_ORIGINS en docker-compose.yml.
PUBLIC_HOST=localhost

# --- Backend ---
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
PORT=3000
# development | production (production endurece CORS)
NODE_ENV=development

# Clave (32 caracteres) para cifrar la password SMTP guardada en la base de datos.
# Definirla ANTES de configurar SMTP; si se cambia despues hay que reingresar la password SMTP.
# SMTP_ENCRYPTION_KEY=

# --- Usuario inicial OWNER (lo crea el contenedor backend al arrancar) ---
OWNER_SEED_EMAIL=admin@shieldtrack.com
OWNER_SEED_PASSWORD=Admin123!
# true = reescribe password/rol del OWNER existente en cada arranque (usar solo para recuperar acceso)
ALLOW_OWNER_RESET=false
# true = carga usuarios y datos de prueba (solo desarrollo/QA, nunca produccion)
RUN_TEST_SEEDS=false

# --- MongoDB (usuario root; solo se aplica al crear el volumen por primera vez) ---
MONGO_INITDB_ROOT_USERNAME=shieldtrack
MONGO_INITDB_ROOT_PASSWORD=shieldtrack_dev

# MONGODB_URI, FRONTEND_URL y CORS_ORIGINS NO se leen de aqui: docker-compose.yml
# los construye a partir de las variables anteriores.
